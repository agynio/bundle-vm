# Platform image build inputs.
#
# The platform image is built ON TOP of a bundle-vm-base disk (which already
# provides Ubuntu + k3s + cert-manager + Istio + Argo CD + the argocd route).
# This file pins the platform layer that Argo CD reconciles during the build.

# Base image this platform image inherits from. Override BASE_IMAGE to point at
# a specific bundle-vm-base qcow2 (defaults resolved by scripts/build.sh).
BASE_IMAGE_REPO=../bundle-vm-base/packer/output

# Ingress: inside the VM the Istio gateway always terminates TLS on container
# port 443 (surfaced by the istio-ingressgateway NodePort). INGRESS_HOST_PORT is
# only the host port Lima forwards onto that NodePort, and the public port that
# URL-embedding components (OpenZiti advertisedPort, gateway public URLs) use.
INGRESS_HOST_PORT=2496
INGRESS_NODEPORT=32443
BASE_DOMAIN=agyn.dev

# Platform GitOps revision (agynio/platform chart channel). Individual chart
# versions are pinned per-Application in gitops/.
DISK_SIZE=32G
