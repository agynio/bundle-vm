# Platform image build inputs.
#
# The platform image is built ON TOP of a bundle-vm-base disk (Ubuntu + k3s +
# cert-manager + Helm/kubectl). This file pins the build's inputs.

# Base image this platform image inherits from.
#
# BASE_IMAGE_VERSION is the pin: scripts/fetch-base.sh pulls that version from
# BASE_IMAGE_REGISTRY, so a build depends on a named published artifact rather
# than on whichever qcow2 happens to sit in a sibling checkout. That is what
# makes the same build reproducible in CI and on a laptop.
#
# BASE_IMAGE_REPO is the local-development escape hatch, used only when
# scripts/build.sh runs with no BASE_IMAGE set: a sibling bundle-vm-base
# checkout you built yourself.
# Published by agynio/bundle-vm-base CI. A push to main publishes
# sha-<commit>; a tag publishes a version. Only amd64 exists so far — for an
# arm64 build, point BASE_IMAGE at a locally built qcow2 until the base is
# released for arm64 too.
BASE_IMAGE_VERSION=sha-541bfed4c870
BASE_IMAGE_REGISTRY=ghcr.io/agynio/bundle-vm-base
BASE_IMAGE_REPO=../bundle-vm-base/packer/output

# Ingress. Inside the VM the Istio gateway always terminates TLS on container
# port 443, surfaced by the istio-ingressgateway NodePort.
#
# INGRESS_HOST_PORT is only the default port Lima forwards onto that NodePort.
# It is a default, not a constant: the user picks the host port, and
# scripts/set-ingress-port.sh repoints the browser-facing URLs on first boot.
# The port OpenZiti advertises is separate and fixed — see install-platform.sh.
INGRESS_HOST_PORT=2496
INGRESS_NODEPORT=32443
BASE_DOMAIN=agyn.dev

DISK_SIZE=32G
